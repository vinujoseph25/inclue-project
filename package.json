{
  "name": "inclue-project",
  "version": "0.1.0",
  "description": "Inclue",
  "main": "index.tsx",
  "scripts": {
    "dev": "cross-env NODE_ENV=local NODE_OPTIONS=--max_old_space_size=8192 TARGET_ENV=local webpack-dev-server --history-api-fallback --open --config config/webpack.config.js",
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--max_old_space_size=8192 TARGET_ENV=DEV webpack --mode production --config config/webpack.config.js",
    "serve-build": "serve dist -l 8080",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:only-errors": "eslint --quiet \"src/**/*.{ts,tsx}\"",
    "prettier": "node node_modules/prettier/bin-prettier.js --config config/prettier.config.js --parser typescript --single-quote --write \"./src/**/*.{ts,tsx}\"",
    "clean:dist": "rimraf dist",
    "test": "jest --config ./config/jest.config.js",
    "test:watch": "jest --watch --maxWorkers=1 --config ./config/jest.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mui/material": "5.11.4",
    "@mui/styles": "^5.11.4",
    "classnames": "^2.2.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl-universal": "^2.3.1",
    "react-router-dom": "^5.3.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.js": [
      "prettier --config config/prettier.config.js --single-quote --write",
      "git add"
    ],
    "src/**/*.jsx": [
      "prettier --config config/prettier.config.js --single-quote --write",
      "git add"
    ],
    "src/**/*.ts": [
      "prettier --config config/prettier.config.js --parser typescript --single-quote --write",
      "git add",
      "npm run lint"
    ],
    "src/**/*.tsx": [
      "prettier --config config/prettier.config.js --parser typescript --single-quote --write",
      "git add",
      "npm run lint"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.7.7",
    "@babel/preset-env": "^7.7.7",
    "@babel/preset-react": "^7.7.7",
    "@babel/preset-typescript": "^7.7.7",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^3.6.1",
    "@typescript-eslint/parser": "^3.6.1",
    "babel-jest": "^29.5.0",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.2",
    "css-loader": "^3.5.2",
    "css-minimizer-webpack-plugin": "^4.2.2",
    "cypress-file-upload": "^4.0.7",
    "dotenv": "^8.2.0",
    "eslint": "^7.32.0",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-react": "^7.20.3",
    "eslint-plugin-react-hooks": "^4.3.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^3.0.9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-when": "^3.6.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^9.4.2",
    "mini-css-extract-plugin": "^1.3.9",
    "node-polyfill-webpack-plugin": "^2.0.1",
    "prettier": "^2.0.5",
    "raw-loader": "^4.0.1",
    "react-test-renderer": "^18.1.0",
    "resolve-url-loader": "^3.1.1",
    "rimraf": "^5.0.0",
    "sass": "^1.56.1",
    "sass-loader": "^8.0.2",
    "sass-resources-loader": "^2.0.3",
    "serve": "^14.2.4",
    "source-map-loader": "^0.2.4",
    "string-replace-loader": "^3.1.0",
    "style-loader": "^1.1.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.2",
    "tsconfig-paths-webpack-plugin": "^4.0.0",
    "typescript": "^4.5.5",
    "url-loader": "^4.1.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.11.1",
    "webpack-manifest-plugin": "^5.0.0",
    "webpack-remove-empty-scripts": "^1.1.1",
    "webpack-visualizer-plugin": "^0.1.11"
  }
}